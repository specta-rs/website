{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".source",
    ".wrangler",
    "src/cloudflare-env.d.ts",
    "src/pages.gen.ts",
    "pnpm-lock.yaml",
    "content/docs/rspc/*/integrations/axum.mdx",
    "content/docs/*/typescript-api"
  ]
}
