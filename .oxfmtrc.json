{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "doc_build",
    ".wrangler",
    "theme/site-data.json",
    "pnpm-lock.yaml",
    "content/docs/rspc/*/integrations/axum.mdx",
    "content/docs/*/typescript-api",
    "content/docs/gurafi",
    "content/docs/besu",
    "content/docs/fsk",
    "docs-sources"
  ]
}
