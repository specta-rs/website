{
  "name": "@specta/website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/reference/pages.mjs && fumadocs-mdx",
    "dev": "node scripts/reference/pages.mjs && waku dev",
    "build": "node scripts/reference/pages.mjs && waku build && node scripts/patch-cloudflare-wrangler.mjs",
    "start": "waku start",
    "typecheck": "wrangler types src/cloudflare-env.d.ts && node scripts/reference/pages.mjs && fumadocs-mdx && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "node --test scripts/reference/*.test.mjs",
    "reference:pages": "node scripts/reference/pages.mjs",
    "reference:sync": "node scripts/reference/rust.mjs --refresh && node scripts/reference/typescript.mjs --refresh && node scripts/reference/pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fumadocs/ui": "16.5.0",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.14.0",
    "waku": "1.0.0-rc.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontaine": "^1.0.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-arraybuffer": "^0.1.4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "next": "16.4.0",
      "postcss": "8.5.29",
      "sharp": "0.35.5"
    }
  }
}
