{
  "name": "@specta/website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/reference/pages.mjs && node --experimental-strip-types scripts/site-data.mjs",
    "dev": "node scripts/reference/pages.mjs && node --experimental-strip-types scripts/site-data.mjs && rspress dev",
    "build": "node scripts/reference/pages.mjs && node --experimental-strip-types scripts/site-data.mjs && rspress build",
    "start": "rspress preview",
    "typecheck": "node scripts/reference/pages.mjs && node --experimental-strip-types scripts/site-data.mjs && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "node --test scripts/reference/*.test.mjs",
    "reference:pages": "node scripts/reference/pages.mjs",
    "reference:sync": "node scripts/reference/typescript.mjs --refresh && node scripts/reference/pages.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "posthog-js": "^1.447.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.17.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rspress/core": "2.1.1",
    "@rspress/plugin-llms": "2.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "wrangler": "^4.156.1"
  },
  "packageManager": "pnpm@10.33.1"
}
